# Copy this file to .env and replace both example values before starting the server.
# Use an HTTPS origin without credentials, a path, a query, or a fragment.
GITLAB_URL=https://gitlab.example.com
# Use the full namespace/project path. Subgroups are supported.
GITLAB_PROJECT=example/team-project

# Optional: set GLAB_PATH if glab is not on PATH or in the standard Windows location.
# Keep CLI credentials in GitLab CLI's credential storage, not in this example file.
