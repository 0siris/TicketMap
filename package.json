{
  "name": "gitlab-ticket-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke-live.mjs",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cytoscape": "^3.33.1",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
